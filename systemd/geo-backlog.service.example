[Unit]
Description=Example GEO Tools backlog
After=network-online.target

[Service]
User=geoapps
Group=geoapps
WorkingDirectory=/opt/example-geo-tools/backlog
EnvironmentFile=/etc/example-geo-tools.env
ExecStart=/opt/example-geo-tools/backlog/.venv/bin/gunicorn --bind 127.0.0.1:5090 --workers 2 config.wsgi:application
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/example-geo-tools/backlog

[Install]
WantedBy=multi-user.target

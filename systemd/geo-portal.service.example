[Unit]
Description=Example GEO Tools authentication portal
After=network-online.target

[Service]
User=geoapps
Group=geoapps
WorkingDirectory=/opt/example-geo-tools/portal
EnvironmentFile=/etc/example-geo-tools.env
ExecStart=/opt/example-geo-tools/portal/.venv/bin/gunicorn --bind 127.0.0.1:8000 --workers 2 core.wsgi:application
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/example-geo-tools/portal

[Install]
WantedBy=multi-user.target
